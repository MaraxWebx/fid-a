  const handleSaveSchedule = async () => {
    setSavingSchedule(true);
    setCatalogError(null);
    setSaveFeedback(null);

    const openingDays = weekdayOptions
      .filter(({ key }) => schedule[key].enabled)
      .map(({ key }) => key);
