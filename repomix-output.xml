                              onPress={() => copyDaySchedule(day.key)}
                              style={styles.iconActionButton}
                            >
                              <Ionicons color={colors.brandInk} name="copy-outline" size={16} />
                            </Pressable>
                            <Pressable
                              disabled={!copiedSchedule}
                              onPress={() => pasteDaySchedule(day.key)}
